# این فایل رو کپی کن به .env و مقادیر واقعی رو جایگزین کن

# توکنی که از @botfather در بله گرفتی
BOT_TOKEN=123456:ABCDEF...

# آدرس عمومی HTTPS سروری که این پروژه روش دیپلوی شده (بدون / آخر)
BASE_URL=https://your-domain.example.com

# یک رشته‌ی تصادفی و مخفی برای مسیر وبهوک (مثلا با: python -c "import secrets;print(secrets.token_urlsafe(24))")
WEBHOOK_SECRET_PATH=REPLACE_WITH_RANDOM_STRING

# توکن مخفیِ ورود به عنوان ادمین (این رو با هیچ‌کس به‌جز ادمین در میون نذار)
ADMIN_START_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN

# رشته‌ی اتصال به PostgreSQL
# برای اجرا با docker-compose نیازی به تغییر این مقدار نیست (خودش override می‌شه)
# برای اجرای مستقیم (بدون داکر)، یک PostgreSQL محلی بالا بیار و این رو مطابقش تنظیم کن
DATABASE_URL=postgresql://bale:bale@localhost:5432/anon_bale_bot

PORT=5000

# فقط برای تست لوکال روی سیستم خودت (بدون اپ واقعی بله) - در پروداکشن حتما 0 بذار
DEV_MODE=0
